FROM docker.io/axolotlai/axolotl-uv@sha256:ee66d1b20b1f308996857e3a08b8b20903f9c8df827bc8b50e37ccb7b9215fbd

ARG GITSHA
ENV AXOLOTL_SOURCE_COMMIT="${GITSHA}"
LABEL org.opencontainers.image.source="https://github.com/marin-community/axolotl" \
      org.opencontainers.image.revision="${GITSHA}" \
      org.opencontainers.image.title="Marin Tinker SFT reproduction"

COPY examples/marin/tinker-openthoughts3-sft.yaml /workspace/axolotl/examples/marin/tinker-openthoughts3-sft.yaml
COPY scripts/__init__.py /workspace/axolotl/scripts/__init__.py
COPY scripts/marin_experiments /workspace/axolotl/scripts/marin_experiments

RUN python -c "import importlib.metadata; assert importlib.metadata.version('axolotl') == '0.19.0'"
